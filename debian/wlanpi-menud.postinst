#!/bin/sh
# wlanpi-menud postinst
set -e

if [ "$1" = "configure" ]; then
    # local.sock group: members (root, wlanpi, SSH users running the TUI)
    # may connect. postrm removes it on purge unless users were added to it.
    if ! getent group wlanpi-menud >/dev/null; then
        groupadd --system wlanpi-menud
    fi
    # The service user. It already exists on WLAN Pi images.
    if ! getent passwd wlanpi >/dev/null; then
        useradd --system --no-create-home --shell /usr/sbin/nologin wlanpi
    fi

    # Refuse to (re)start on manifests that do not validate: the running
    # service, if any, keeps going and the install fails loudly.
    if ! /opt/wlanpi-menud/bin/wlanpi-menud --check --config /etc/wlanpi-menud/config.toml; then
        echo "wlanpi-menud: shipped menu manifests failed validation; not restarting" >&2
        exit 1
    fi

    # Enable WebUI proxy snippet if wlanpi-webui is installed
    if [ -f /etc/wlanpi-webui/nginx/conf-available/wlanpi-menud.conf ]; then
        mkdir -p /etc/wlanpi-webui/nginx/conf.d
        ln -sf /etc/wlanpi-webui/nginx/conf-available/wlanpi-menud.conf /etc/wlanpi-webui/nginx/conf.d/wlanpi-menud.conf
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet nginx.service; then
            systemctl reload nginx.service || true
        fi
    fi
fi

#DEBHELPER#

exit 0
