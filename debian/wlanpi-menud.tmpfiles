# /run/wlanpi-menud holds local.sock; /run/wlanpi-menud/proxy holds proxy.sock.
# Installed as /usr/lib/tmpfiles.d/wlanpi-menud.conf. Applied at boot, and by
# the unit's ExecStartPre=+ on every start, because RuntimeDirectory= recreates
# the top directory without the ACL or the subdirectory.
#
# 0750 wlanpi:wlanpi-menud: only the service and wlanpi-menud members may list
# it. nginx (www-data) gets traverse only (--x) through a POSIX ACL, enough to
# reach proxy/ and no more.
d  /run/wlanpi-menud        0750 wlanpi wlanpi-menud -
a+ /run/wlanpi-menud        -    -      -            - group:www-data:--x
# setgid, group www-data: proxy.sock inherits group www-data when it is bound,
# so the service never chowns it and needs no SupplementaryGroups=www-data.
d  /run/wlanpi-menud/proxy  2750 wlanpi www-data     -
