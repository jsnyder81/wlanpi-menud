#!/usr/bin/make -f
# Build wlanpi-menud with dh-virtualenv: a private virtualenv at /opt/wlanpi-menud.

export DH_VIRTUALENV_INSTALL_ROOT=/opt
SNAKE=/usr/bin/python3
PACKAGE=$(shell dh_listpackages)
DH_VENV_DIR=debian/$(PACKAGE)$(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE)

%:
	dh $@ --with python-virtualenv

# dh-virtualenv does the build and install; the tests run in CI and against
# the built venv (see README), not inside the package build.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_install:
override_dh_auto_test:
override_dh_dwz:

override_dh_virtualenv:
	dh_virtualenv \
		--install-suffix "wlanpi-menud" \
		--builtin-venv \
		--python $(SNAKE) \
		--upgrade-pip \
		--preinstall="setuptools>=68" \
		--preinstall="wheel" \
		--extra-pip-arg="--compile"
	# Drop build leftovers from the venv tree.
	rm -rf $(DH_VENV_DIR)/.cache $(DH_VENV_DIR)/.gitignore
	find $(DH_VENV_DIR)/include -type d -empty -delete
	# Text files that still name the build tree get the installed path.
	# direct_url.json only records the build checkout pip installed from.
	rm -f $(DH_VENV_DIR)/lib/python3*/site-packages/$(subst -,_,$(PACKAGE))-*.dist-info/direct_url.json
	grep -rlF "$(CURDIR)/$(DH_VENV_DIR)" $(DH_VENV_DIR)/bin $(DH_VENV_DIR)/pyvenv.cfg \
		| xargs -r sed -i "s|$(CURDIR)/$(DH_VENV_DIR)|$(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE)|g"
	# Byte-compile with the installed paths, so tracebacks name /opt files.
	# /opt is read-only to the service (ProtectSystem=strict), so the cache
	# has to ship in the package.
	$(SNAKE) -m compileall -q -f -j0 -s $(DH_VENV_DIR) -p $(DH_VIRTUALENV_INSTALL_ROOT)/$(PACKAGE) \
		$(DH_VENV_DIR)/lib

# File::Find loses its cwd walking the dh-virtualenv tree; the step is cosmetic.
override_dh_strip_nondeterminism:

override_dh_installsystemd:
	dh_installsystemd --name=wlanpi-menud

# sudoers drop-ins must be 0440 or sudo ignores them.
execute_after_dh_fixperms:
	chmod 0440 debian/$(PACKAGE)/etc/sudoers.d/wlanpi-menud
	chmod 0755 debian/$(PACKAGE)/usr/libexec/wlanpi-menud/get-core-token
