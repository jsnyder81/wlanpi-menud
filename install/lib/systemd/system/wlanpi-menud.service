[Unit]
Description=WLAN Pi menu service (wlanpi-menud)
Documentation=https://github.com/WLAN-Pi/wlanpi-menud
After=network.target wlanpi-core.service
Wants=wlanpi-core.service

[Service]
# READY=1 is sent once both sockets are bound (sd_notify, no libsystemd).
Type=notify
NotifyAccess=main
User=wlanpi
Group=wlanpi-menud
# local.sock lives here, proxy.sock in proxy/ below it. systemd creates and
# removes the top directory; 0750 so only wlanpi-menud members can list it.
RuntimeDirectory=wlanpi-menud
RuntimeDirectoryMode=0750
UMask=0007
# Root, unsandboxed ("+"): add nginx's traverse-only ACL to the directory and
# create the setgid www-data proxy/ directory (see tmpfiles.d/wlanpi-menud.conf).
# proxy.sock inherits group www-data from it, so the service needs no
# SupplementaryGroups=www-data.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create wlanpi-menud.conf
ExecStart=/opt/wlanpi-menud/bin/wlanpi-menud --config /etc/wlanpi-menud/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Hardening. The token helper runs through sudo, which needs setuid, so
# NoNewPrivileges= and CapabilityBoundingSet= stay unset. Everything below
# was checked on trixie (systemd 257) to leave NoNewPrivs at 0 and the
# helper working: systemd installs the seccomp filters before it drops to
# User=, so they do not imply NoNewPrivileges.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# No hardware: only /dev/null, zero, full, random, urandom, tty, pts.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Unix sockets only, plus loopback HTTPS to wlanpi-core. No listener on IP.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# sudo keeps its timestamp records here.
ReadWritePaths=-/run/sudo

# Resource budget (docs/resource-budget.md). Steady RSS is about 42 MiB and
# the budgeted peak is 96 MiB; MemoryHigh starts reclaim above that and
# MemoryMax is the hard line. Both are inert on images that boot with
# cgroup_disable=memory (the 26.10 image does); the budget doc says how to
# measure there.
MemoryHigh=80M
MemoryMax=112M
# Core and capture work win under contention (default weight is 100).
CPUWeight=50

[Install]
WantedBy=multi-user.target
